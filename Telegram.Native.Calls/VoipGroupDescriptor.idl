import "Telegram.Native.Calls.idl";
import "VoipVideoCapture.idl";

namespace Telegram.Native.Calls
{
    [default_interface]
    runtimeclass VoipGroupDescriptor
    {
        VoipGroupDescriptor();

        String AudioInputId;
        String AudioOutputId;
        VoipVideoContentType VideoContentType;
        VoipCaptureBase VideoCapture;

        Boolean IsConference;
        Boolean IsNoiseSuppressionEnabled;

        // GroupInstanceReferenceImpl, the PeerConnection engine, instead of GroupInstanceCustomImpl.
        Boolean IsReferenceImpl;

        // An RTMP stream: no engine, nothing sent, only the stream played.
        Boolean IsStream;

        Int64 AudioProcessId;
    }
}
