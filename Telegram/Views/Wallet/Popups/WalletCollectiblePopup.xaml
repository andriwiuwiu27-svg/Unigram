<controls:ModalPopup x:Class="Telegram.Views.Wallet.Popups.WalletCollectiblePopup"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:controls="using:Telegram.Controls"
                     mc:Ignorable="d"
                     IsDismissButtonVisible="True"
                     DefaultButton="Primary">

    <StackPanel>
        <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                CornerRadius="12"
                HorizontalAlignment="Center"
                Width="120"
                Height="120"
                Margin="0,12,0,0">
            <controls:ImageView x:Name="Photo"
                                Stretch="UniformToFill"
                                CornerRadius="12" />
        </Border>

        <TextBlock x:Name="Title"
                   Style="{StaticResource PopupTextBlockStyle}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="12,16,12,0" />

        <TextBlock x:Name="Description"
                   Style="{StaticResource InfoBodyTextBlockStyle}"
                   TextAlignment="Center"
                   Margin="12,4,12,0" />

        <Grid ColumnSpacing="8"
              Margin="0,20,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <controls:SettingsButton x:Name="TransferButton"
                                     Click="Transfer_Click"
                                     Content="{CustomResource WalletTransfer}"
                                     Style="{StaticResource GlyphGridBadgeButtonStyle}"
                                     Glyph="&#xEAC6;" />

            <controls:SettingsButton Click="Sell_Click"
                                     Content="{CustomResource WalletSell}"
                                     Style="{StaticResource GlyphGridBadgeButtonStyle}"
                                     Glyph="&#xEA68;"
                                     Grid.Column="1" />
        </Grid>

        <controls:TableView x:Name="Attributes"
                            Margin="-8,0,-8,0" />
    </StackPanel>
</controls:ModalPopup>
