<controls:ModalPopup x:Class="Telegram.Views.Popups.DeleteMessagesPopup"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="using:Telegram.Views.Popups"
                     xmlns:controls="using:Telegram.Controls"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     mc:Ignorable="d"
                     Title="Delete"
                     DefaultButton="None"
                     PrimaryButtonStyle="{StaticResource DangerButtonStyle}"
                     PrimaryButtonText="Delete"
                     SecondaryButtonText="Cancel"
                     Padding="0,24,0,0">

    <controls:ModalPopup.Resources>
        <ControlTemplate x:Key="SettingsExpanderPopupTemplate"
                         TargetType="controls:SettingsExpander">
            <Grid CornerRadius="{TemplateBinding CornerRadius}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="PopupHost"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Padding="{TemplateBinding Padding}"
                        Grid.Row="1">
                    <ContentPresenter x:Name="PopupRoot" />
                </Border>

                <controls:SettingsButton x:Name="ActionButton"
                                         Content="{TemplateBinding Header}"
                                         Badge="{TemplateBinding Badge}"
                                         BadgeTemplate="{TemplateBinding BadgeTemplate}"
                                         BadgeVisibility="{TemplateBinding BadgeVisibility}"
                                         BadgeLabel="{TemplateBinding BadgeLabel}"
                                         Description="{TemplateBinding Description}"
                                         Glyph="{TemplateBinding Glyph}"
                                         IsGlyphVisible="{TemplateBinding IsGlyphVisible}"
                                         IsPremiumVisible="{TemplateBinding IsPremiumVisible}"
                                         IsChevronVisible="True"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                         Padding="0"
                                         MinHeight="{TemplateBinding MinHeight}"
                                         HorizontalAlignment="Stretch">
                    <controls:SettingsButton.Template>
                        <ControlTemplate TargetType="controls:SettingsButton">
                            <ContentPresenter Background="Transparent" />
                        </ControlTemplate>
                    </controls:SettingsButton.Template>
                </controls:SettingsButton>
            </Grid>
        </ControlTemplate>
    </controls:ModalPopup.Resources>

    <ScrollViewer x:Name="ScrollingHost"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Auto">
        <StackPanel Margin="24,0,24,24">
            <StackPanel x:Name="BasicRoot"
                        Visibility="Collapsed">
                <TextBlock x:Name="Message"
                           Style="{StaticResource BodyTextBlockStyle}" />

                <CheckBox x:Name="RevokeCheck"
                          FontFamily="{ThemeResource EmojiThemeFontFamily}"
                          Margin="0,16,0,-8" />
            </StackPanel>
            <StackPanel x:Name="AdditionalRoot">
                <TextBlock Text="{CustomResource DeleteAdditionalActions}"
                           Style="{StaticResource BaseTextBlockStyle}"
                           Margin="0,0,0,4" />
                <controls:SettingsExpander x:Name="ReportSpamExpander"
                                           Template="{StaticResource SettingsExpanderPopupTemplate}"
                                           ExpandedChanged="ReportSpam_Expanded"
                                           Background="Transparent"
                                           MinHeight="32">
                    <controls:SettingsExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ReportSpamCheck"
                                      Checked="ReportSpam_Checked"
                                      Unchecked="ReportSpam_Checked" />

                            <TextBlock x:Name="ReportSpamIcon"
                                       Text="&#xE9B9;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"
                                       Grid.Column="1" />

                            <controls:AnimatedTextBlock x:Name="ReportSpamCount"
                                                        TextStyle="{StaticResource BaseTextBlockStyle}"
                                                        VerticalAlignment="Center"
                                                        Grid.Column="2" />
                        </Grid>
                    </controls:SettingsExpander.Header>
                    <StackPanel x:Name="ReportSpamRoot"
                                Margin="8,0,0,0">

                    </StackPanel>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Name="DeleteAllMessagesExpander"
                                           Template="{StaticResource SettingsExpanderPopupTemplate}"
                                           ExpandedChanged="DeleteAllMessages_Expanded"
                                           Background="Transparent"
                                           MinHeight="32">
                    <controls:SettingsExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="DeleteAllMessagesCheck"
                                      Checked="DeleteAllMessages_Checked"
                                      Unchecked="DeleteAllMessages_Checked" />

                            <TextBlock x:Name="DeleteAllMessagesIcon"
                                       Text="&#xE9B9;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"
                                       Grid.Column="1" />

                            <controls:AnimatedTextBlock x:Name="DeleteAllMessagesCount"
                                                        TextStyle="{StaticResource BaseTextBlockStyle}"
                                                        VerticalAlignment="Center"
                                                        Grid.Column="2" />
                        </Grid>
                    </controls:SettingsExpander.Header>
                    <StackPanel x:Name="DeleteAllMessagesRoot"
                                Margin="8,0,0,0">

                    </StackPanel>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Name="DeleteAllReactionsExpander"
                                           Template="{StaticResource SettingsExpanderPopupTemplate}"
                                           ExpandedChanged="DeleteAllReactions_Expanded"
                                           Background="Transparent"
                                           MinHeight="32">
                    <controls:SettingsExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="DeleteAllReactionsCheck"
                                      Checked="DeleteAllReactions_Checked"
                                      Unchecked="DeleteAllReactions_Checked" />

                            <TextBlock x:Name="DeleteAllReactionsIcon"
                                       Text="&#xE9B9;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"
                                       Grid.Column="1" />

                            <controls:AnimatedTextBlock x:Name="DeleteAllReactionsCount"
                                                        TextStyle="{StaticResource BaseTextBlockStyle}"
                                                        VerticalAlignment="Center"
                                                        Grid.Column="2" />
                        </Grid>
                    </controls:SettingsExpander.Header>
                    <StackPanel x:Name="DeleteAllReactionsRoot"
                                Margin="8,0,0,0">

                    </StackPanel>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Name="DeleteAllExpander"
                                           Template="{StaticResource SettingsExpanderPopupTemplate}"
                                           Background="Transparent"
                                           MinHeight="32"
                                           Visibility="Collapsed">
                    <controls:SettingsExpander.Header>
                        <CheckBox x:Name="DeleteAllCheck"
                                  Checked="DeleteAll_Checked"
                                  Unchecked="DeleteAll_Checked">
                            <TextBlock>
                                <Run x:Name="DeleteAllText" />
                                <Run x:Name="DeleteAllCount"
                                     FontWeight="SemiBold" />
                            </TextBlock>
                        </CheckBox>
                    </controls:SettingsExpander.Header>
                    <StackPanel Margin="8,0,0,0">
                        <CheckBox x:Name="DeleteAllMessagesItem"
                                  Checked="DeleteAllItem_Checked"
                                  Unchecked="DeleteAllItem_Checked"
                                  Content="{CustomResource RestrictUserDeleteAllMessages}" />

                        <CheckBox x:Name="DeleteAllReactionsItem"
                                  Checked="DeleteAllItem_Checked"
                                  Unchecked="DeleteAllItem_Checked"
                                  Content="{CustomResource RestrictUserDeleteAllReactions}" />
                    </StackPanel>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Name="BanUserExpander"
                                           Template="{StaticResource SettingsExpanderPopupTemplate}"
                                           ExpandedChanged="BanUser_Expanded"
                                           Background="Transparent"
                                           MinHeight="32">
                    <controls:SettingsExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="BanUserCheck"
                                      Checked="BanUser_Checked"
                                      Unchecked="BanUser_Checked" />

                            <TextBlock x:Name="BanUserIcon"
                                       Text="&#xE9B9;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"
                                       Grid.Column="1" />

                            <controls:AnimatedTextBlock x:Name="BanUserCount"
                                                        TextStyle="{StaticResource BaseTextBlockStyle}"
                                                        VerticalAlignment="Center"
                                                        Grid.Column="2" />
                        </Grid>
                    </controls:SettingsExpander.Header>
                    <StackPanel x:Name="BanUserRoot"
                                Margin="8,0,0,0">

                    </StackPanel>
                </controls:SettingsExpander>

                <StackPanel x:Name="PermissionsPanel"
                            Visibility="Collapsed">
                    <controls:AnimatedTextBlock x:Name="PermissionsHeader"
                                                TextStyle="{StaticResource BaseTextBlockStyle}"
                                                Margin="0,12,0,4" />

                    <CheckBox x:Name="CanSendBasicMessages"
                              IsChecked="{x:Bind ViewModel.CanSendBasicMessages, Mode=TwoWay}"
                              Content="{CustomResource UserRestrictionsSend}" />

                    <controls:SettingsExpander Template="{StaticResource SettingsExpanderPopupTemplate}"
                                               Background="Transparent"
                                               MinHeight="32">
                        <controls:SettingsExpander.Header>
                            <CheckBox x:Name="CanSendMediaMessages"
                                      IsChecked="{x:Bind ViewModel.CanSendMediaMessages, Mode=TwoWay}">
                                <TextBlock>
                                <Run Text="{CustomResource UserRestrictionsSendMedia}" />
                                <Run Text="{x:Bind ConvertCanSendCount(ViewModel.CanSendCount), Mode=OneWay}"
                                     FontWeight="SemiBold" />
                                </TextBlock>
                            </CheckBox>

                        </controls:SettingsExpander.Header>
                        <StackPanel Margin="8,0,0,0">
                            <CheckBox x:Name="CanSendPhotos"
                                      IsChecked="{x:Bind ViewModel.CanSendPhotos, Mode=TwoWay}"
                                      Content="{CustomResource UserRestrictionsSendPhotos}" />

                            <CheckBox x:Name="CanSendVideos"
                                      IsChecked="{x:Bind ViewModel.CanSendVideos, Mode=TwoWay}"
                                      Content="{CustomResource UserRestrictionsSendVideos}" />

                            <CheckBox x:Name="CanSendOtherMessages"
                                      IsChecked="{x:Bind ViewModel.CanSendOtherMessages, Mode=TwoWay}"
                                      Content="{CustomResource UserRestrictionsSendStickers}" />

                            <CheckBox x:Name="CanSendAudios"
                                      IsChecked="{x:Bind ViewModel.CanSendAudios, Mode=TwoWay}"
                                      Content="{CustomResource UserRestrictionsSendMusic}" />

                            <CheckBox x:Name="CanSendDocuments"
                                      IsChecked="{x:Bind ViewModel.CanSendDocuments, Mode=TwoWay}"
                                      Content="{CustomResource UserRestrictionsSendFiles}" />

                            <CheckBox x:Name="CanSendVoiceNotes"
                                      IsChecked="{x:Bind ViewModel.CanSendVoiceNotes, Mode=TwoWay}"
                                      Content="{CustomResource UserRestrictionsSendVoices}" />

                            <CheckBox x:Name="CanSendVideoNotes"
                                      IsChecked="{x:Bind ViewModel.CanSendVideoNotes, Mode=TwoWay}"
                                      Content="{CustomResource UserRestrictionsSendRound}" />

                            <CheckBox x:Name="CanSendPolls"
                                      IsChecked="{x:Bind ViewModel.CanSendPolls, Mode=TwoWay}"
                                      Content="{CustomResource UserRestrictionsSendPolls}" />

                            <CheckBox x:Name="CanAddLinkPreviews"
                                      IsChecked="{x:Bind ViewModel.CanAddLinkPreviews, Mode=TwoWay}"
                                      Content="{CustomResource UserRestrictionsEmbedLinks}" />

                            <CheckBox x:Name="CanReactToMessages"
                                      IsChecked="{x:Bind ViewModel.CanReactToMessages, Mode=TwoWay}"
                                      Content="{CustomResource UserRestrictionsSendReactions}" />
                        </StackPanel>
                    </controls:SettingsExpander>

                    <CheckBox x:Name="CanInviteUsers"
                              IsChecked="{x:Bind ViewModel.CanInviteUsers, Mode=TwoWay}"
                              Content="{CustomResource UserRestrictionsInviteUsers}" />

                    <CheckBox x:Name="CanPinMessages"
                              IsChecked="{x:Bind ViewModel.CanPinMessages, Mode=TwoWay}"
                              Content="{CustomResource UserRestrictionsPinMessages}" />

                    <CheckBox x:Name="CanEditTag"
                              IsChecked="{x:Bind ViewModel.CanEditTag, Mode=TwoWay}"
                              Content="{CustomResource UserRestrictionsEditTags}" />

                    <CheckBox x:Name="CanChangeInfo"
                              IsChecked="{x:Bind ViewModel.CanChangeInfo, Mode=TwoWay}"
                              Content="{CustomResource UserRestrictionsChangeInfo}" />
                </StackPanel>

                <Button x:Name="PermissionsToggle"
                        Click="PermissionsToggle_Click"
                        Style="{StaticResource AccentTextButtonStyle}"
                        Margin="-12,8,0,-8" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</controls:ModalPopup>
