<messages:MessageService x:Class="Telegram.Controls.Messages.Service.MessageUpgradedGiftOnChainPurchaseOfferContent"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="using:Telegram.Controls.Messages.Service"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:messages="using:Telegram.Controls.Messages"
                         xmlns:controls="using:Telegram.Controls"
                         mc:Ignorable="d"
                         d:DesignHeight="300"
                         d:DesignWidth="400">

    <Button.Template>
        <ControlTemplate TargetType="Button">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentPresenter HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" />
                <messages:ReactionsPanel x:Name="Reactions"
                                         MaxWidth="{StaticResource MessageMaxWidth}"
                                         HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Center"
                                         Padding="0,4,0,0"
                                         Grid.Row="1" />
            </Grid>
        </ControlTemplate>
    </Button.Template>
    <StackPanel>
        <Grid Width="216">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <messages:MessageService x:Name="Service"
                                     Margin="0,4,0,0"
                                     Padding="12,2,12,0"
                                     Width="216">
                <StackPanel>
                    <controls:PatternBackground x:Name="Pattern"
                                                Margin="4,12,4,12"
                                                Padding="12"
                                                CornerRadius="12"
                                                HorizontalAlignment="Center">
                        <controls:AnimatedImage x:Name="Animation"
                                                Width="72"
                                                Height="72"
                                                FrameSize="72,72"
                                                DecodeFrameType="Logical"
                                                IsViewportAware="True"
                                                LoopCount="1" />
                    </controls:PatternBackground>

                    <controls:FormattedTextBlock x:Name="Text"
                                                 Foreground="#FFFFFF"
                                                 TextAlignment="Center"
                                                 Style="{StaticResource CaptionFormattedTextBlockStyle}"
                                                 FontFamily="{StaticResource EmojiThemeFontFamilyWithSymbols}"
                                                 AutoFontSize="False"
                                                 IsTextSelectionEnabled="False"
                                                 Padding="0,0,0,4"
                                                 Margin="0,0,0,8" />
                </StackPanel>
            </messages:MessageService>

            <controls:Ribbon x:Name="Ribbon"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,6,2,0">
                <controls:Ribbon.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop x:Name="RibbonTop"
                                      Color="#6ED2FF"
                                      Offset="0" />
                        <GradientStop x:Name="RibbonBottom"
                                      Color="#35A5FC"
                                      Offset="1" />
                    </LinearGradientBrush>
                </controls:Ribbon.Background>
            </controls:Ribbon>

            <Border x:Name="Action"
                    Background="{ThemeResource MessageServiceBackgroundBrush}"
                    CornerRadius="4,4,11,11"
                    Margin="0,4,0,0"
                    Grid.Row="1">
                <controls:ReplyMarkupInlineButton x:Name="ActionButton"
                                                  Click="Action_Click"
                                                  HorizontalAlignment="Stretch" />
            </Border>
        </Grid>
    </StackPanel>
</messages:MessageService>
