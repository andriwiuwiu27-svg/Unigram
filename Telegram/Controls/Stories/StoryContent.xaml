<controls:UserControlEx x:Class="Telegram.Controls.Stories.StoryContent"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:controls="using:Telegram.Controls"
                        xmlns:cells="using:Telegram.Controls.Cells"
                        xmlns:local="using:Telegram.Controls.Stories"
                        xmlns:messages="using:Telegram.Controls.Messages"
                        xmlns:common="using:Telegram.Common"
                        mc:Ignorable="d"
                        d:DesignHeight="300"
                        d:DesignWidth="400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

    <UserControl.Resources>
        <Style x:Name="SuggestedReactionButtonStyle"
               TargetType="local:StoryReactionButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:StoryReactionButton">
                        <Grid x:Name="LayoutRoot"
                              Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,-4">
                                <controls:CustomEmojiIcon x:Name="Icon"
                                                          CleanOnSourceChanged="False" />
                                <Popup x:Name="Overlay"
                                       IsHitTestVisible="False"
                                       Margin="-70"
                                       Width="210"
                                       Height="210" />
                            </Grid>

                            <controls:AnimatedTextBlock x:Name="Count"
                                                        Foreground="{TemplateBinding Foreground}"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        IsTabStop="False"
                                                        Margin="0,4,0,0"
                                                        Grid.Row="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Black">
        <controls:ImageView x:Name="BackgroundPhoto"
                            Stretch="UniformToFill"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />

        <Grid x:Name="LayoutRoot">
            <Grid.Background>
                <ImageBrush x:Name="ThumbnailTexture"
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center" />
            </Grid.Background>
            <Image x:Name="Texture1"
                   Stretch="UniformToFill"
                   ImageOpened="Texture_ImageOpened" />
            <Image x:Name="Texture2"
                   Stretch="UniformToFill"
                   ImageOpened="Texture_ImageOpened" />

            <Border x:Name="VideoPanel">
                <SwapChainPanel x:Name="Video"
                                x:Load="False" />
            </Border>
        </Grid>

        <Grid x:Name="ActiveRoot"
              Background="Transparent"
              PointerPressed="OnPointerPressed"
              PointerReleased="OnPointerReleased"
              Canvas.ZIndex="1">
            <Rectangle Height="64"
                       Opacity="0.5"
                       VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1"
                                         EndPoint="0,0">
                        <GradientStop Color="#00000000" />
                        <GradientStop Color="#AA000000"
                                      Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <local:StoryProgress x:Name="Progress"
                                 VerticalAlignment="Top"
                                 Margin="8,6,8,0"
                                 Canvas.ZIndex="1" />

            <Grid x:Name="InfoPanel"
                  VerticalAlignment="Top"
                  Margin="0,18,0,0"
                  Canvas.ZIndex="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <HyperlinkButton Click="Photo_Click"
                                 Style="{StaticResource EmptyHyperlinkButtonStyle}"
                                 AutomationProperties.Name="{CustomResource AccDescrProfilePicture}"
                                 HorizontalAlignment="Left"
                                 Canvas.ZIndex="1"
                                 Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <controls:ProfilePicture x:Name="Photo"
                                                 Size="32"
                                                 VerticalAlignment="Top"
                                                 Margin="8,0,8,0" />

                        <Grid VerticalAlignment="Center"
                              Margin="0,-2,0,0"
                              Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Title"
                                           Foreground="{ThemeResource PageHeaderForegroundBrush}"
                                           Style="{StaticResource BaseTextBlockStyle}"
                                           FontFamily="{ThemeResource EmojiThemeFontFamilyWithSymbols}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />

                                <controls:IdentityIcon x:Name="Identity"
                                                       VerticalAlignment="Bottom"
                                                       Margin="4,0,0,2"
                                                       Grid.Column="1" />

                                <TextBlock x:Name="Position"
                                           Foreground="{ThemeResource PageHeaderDisabledBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Bottom"
                                           Margin="8,0,0,1"
                                           Visibility="Collapsed"
                                           Typography.NumeralAlignment="Tabular"
                                           Grid.Column="2" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="LiveBadge"
                                        VerticalAlignment="Bottom"
                                        Background="#FF2C55"
                                        BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Height="16"
                                        MinWidth="16"
                                        Margin="0,0,4,0"
                                        Visibility="Collapsed">
                                    <TextBlock Foreground="#FFFFFF"
                                               Text="{CustomResource LiveStoryBadge}"
                                               TextLineBounds="Tight"
                                               TextAlignment="Center"
                                               OpticalMarginAlignment="TrimSideBearings"
                                               FontSize="9"
                                               Padding="4,0,4,0"
                                               VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular" />
                                </Border>

                                <TextBlock x:Name="PinnedIcon"
                                           Text="&#xEA8A;"
                                           Foreground="{ThemeResource PageHeaderDisabledBrush}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="12"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,4,2"
                                           Visibility="Collapsed"
                                           Grid.Column="1" />

                                <TextBlock x:Name="Subtitle"
                                           Foreground="{ThemeResource PageHeaderDisabledBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Bottom"
                                           Grid.Column="2" />

                                <HyperlinkButton x:Name="SourceButton"
                                                 Click="Source_Click"
                                                 Style="{StaticResource EmptyHyperlinkButtonStyle}"
                                                 VerticalAlignment="Bottom"
                                                 Visibility="Collapsed"
                                                 Grid.Column="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SourceIcon"
                                                   Text="&#xF7B3;"
                                                   Foreground="{ThemeResource PageHeaderDisabledBrush}"
                                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0" />
                                        <controls:ProfilePicture x:Name="SourcePhoto"
                                                                 Size="16"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,4,0"
                                                                 Grid.Column="1" />
                                        <TextBlock x:Name="SourceText"
                                                   Foreground="{ThemeResource PageHeaderDisabledBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontFamily="{ThemeResource EmojiThemeFontFamilyWithSymbols}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Grid.Column="2" />
                                    </Grid>
                                </HyperlinkButton>
                            </Grid>
                        </Grid>
                    </Grid>
                </HyperlinkButton>

                <Border x:Name="Privacy"
                        Width="24"
                        Height="24"
                        CornerRadius="14"
                        Margin="4,0,0,0"
                        Grid.Column="3">
                    <Border.Background>
                        <LinearGradientBrush EndPoint="0,1">
                            <GradientStop Color="#FF78d538" />
                            <GradientStop Color="#FF2ab56d"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock x:Name="PrivacyIcon"
                               Text="&#xEA23;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#FFFFFF"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="16" />
                </Border>

                <controls:GlyphButton x:Name="PrivacyButton"
                                      Click="Privacy_Click"
                                      Glyph=""
                                      Margin="0,-8,-4,-8"
                                      CornerRadius="20"
                                      Grid.Column="3" />

                <controls:GlyphToggleButton x:Name="Mute"
                                            Click="Mute_Click"
                                            Glyph="&#xE74F;"
                                            CheckedGlyph="&#xEA12;"
                                            Margin="0,-8,-4,-8"
                                            CornerRadius="20"
                                            IsOneWay="False"
                                            Grid.Column="4" />

                <controls:GlyphButton x:Name="MutePlaceholder"
                                      Click="MutePlaceholder_Click"
                                      Glyph=""
                                      Margin="0,-8,-4,-8"
                                      CornerRadius="20"
                                      Grid.Column="4" />

                <controls:MoreButton Click="MoreButton_Click"
                                     Margin="0,-8"
                                     CornerRadius="20"
                                     Grid.Column="5" />
            </Grid>

            <Canvas x:Name="AreasPanel" />

            <StackPanel x:Name="UnsupportedPanel"
                        x:Load="False"
                        VerticalAlignment="Center"
                        Margin="72,0">
                <TextBlock Text="{CustomResource StoryUnsupported}"
                           Foreground="#FFFFFF"
                           FontWeight="SemiBold"
                           FontSize="16"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Click="Unsupported_Click"
                        Content="{CustomResource UpdateTelegram}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="0,24,0,0" />
            </StackPanel>

            <Grid x:Name="CaptionRoot">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Rectangle Margin="0,-12,0,0"
                           Grid.Row="1">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1">
                            <GradientStop Color="#00000000" />
                            <GradientStop Color="#AA000000"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Rectangle x:Name="CaptionOverlay"
                           Fill="#7F000000"
                           IsHitTestVisible="False"
                           PointerPressed="CaptionOverlay_PointerPressed"
                           Tapped="CaptionOverlay_Tapped"
                           Grid.RowSpan="2" />

                <Grid x:Name="CaptionPanel"
                      Background="Transparent"
                      SizeChanged="CaptionPanel_SizeChanged"
                      Tapped="CaptionPanel_Tapped"
                      PointerWheelChanged="CaptionPanel_PointerWheelChanged"
                      Padding="12,8"
                      Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <HyperlinkButton x:Name="RepostPanel"
                                     Click="RepostPanel_Click"
                                     Style="{StaticResource EmptyHyperlinkButtonStyle}"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,8"
                                     Visibility="Collapsed">
                        <Border x:Name="RepostBackground"
                                Background="#40000000"
                                BorderBrush="#FFFFFF"
                                CornerRadius="11"
                                Padding="7,0,10,0"
                                Height="22">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="RepostTitle"
                                           Foreground="#FFFFFF"
                                           FontFamily="{ThemeResource EmojiThemeFontFamilyWithSymbols}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                                <TextBlock x:Name="RepostText"
                                           Foreground="#FFFFFF"
                                           FontSize="14"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </HyperlinkButton>

                    <ScrollViewer x:Name="CaptionScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Disabled"
                                  Margin="0,0,-12,0"
                                  Visibility="Collapsed"
                                  Grid.Row="1">
                        <messages:MessageTextBlock x:Name="Caption"
                                                   TextEntityClick="Caption_TextEntityClick"
                                                   Margin="0,0,12,0" />
                    </ScrollViewer>

                    <messages:MessageTextBlock x:Name="CaptionCollapsed"
                                               TextEntityClick="Caption_TextEntityClick"
                                               Grid.Row="1" />
                </Grid>
            </Grid>

            <Grid x:Name="MessagesRoot">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="MessagesShadow"
                        Grid.Row="1"
                        Grid.RowSpan="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1">
                            <common:Scrim.Gradient>
                                <common:CubicBezierGradient TopColor="#00171717"
                                                            BottomColor="#DD171717" />
                            </common:Scrim.Gradient>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <ListView x:Name="MessagesHost"
                          SelectionMode="None"
                          ChoosingItemContainer="MessagesHost_ChoosingItemContainer"
                          ContainerContentChanging="MessagesHost_ContainerContentChanging"
                          SizeChanged="MessagesHost_SizeChanged"
                          Margin="0,-12,0,0"
                          Padding="0,12,0,8"
                          Grid.Row="1">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel VerticalAlignment="Bottom"
                                             ItemsUpdatingScrollMode="KeepLastItemInView" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <cells:LiveStoryMessageCell HorizontalAlignment="Left" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"
                               BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Margin"
                                    Value="8,1" />
                            <Setter Property="Padding"
                                    Value="0" />
                            <Setter Property="MinHeight"
                                    Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <ListView x:Name="PinnedMessagesHost"
                          SelectionMode="None"
                          ContainerContentChanging="PinnedMessagesHost_ContainerContentChanging"
                          Padding="0,0,8,0"
                          Grid.Row="2">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <cells:LiveStoryPinnedMessageCell Click="PinnedMessage_Click" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"
                               BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Margin"
                                    Value="8,1,0,8" />
                            <Setter Property="Padding"
                                    Value="0" />
                            <Setter Property="MinHeight"
                                    Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <local:StoryReactionStream x:Name="ReactionsHost"
                                           SizeChanged="ReactionsHost_SizeChanged"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           IsHitTestVisible="False"
                                           Grid.RowSpan="3" />
            </Grid>
        </Grid>

        <HyperlinkButton x:Name="InactiveRoot"
                         Style="{StaticResource EmptyHyperlinkButtonStyle}">
            <Border Background="#7F000000">
                <StackPanel x:Name="MiniInside"
                            IsHitTestVisible="False"
                            VerticalAlignment="Center"
                            SizeChanged="InactivePanel_SizeChanged">
                    <controls:ActiveStoriesSegments x:Name="SegmentsInactive"
                                                    Width="48"
                                                    Height="48">
                        <controls:ProfilePicture x:Name="PhotoMini"
                                                 Size="48" />
                    </controls:ActiveStoriesSegments>
                    <TextBlock x:Name="TitleMini"
                               Margin="0,4,0,0"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="{ThemeResource EmojiThemeFontFamily}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               HorizontalAlignment="Stretch"
                               Foreground="#FFFFFF" />
                </StackPanel>
            </Border>
        </HyperlinkButton>
    </Grid>
</controls:UserControlEx>
